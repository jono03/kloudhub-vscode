{
  "name": "kloudhub-vscode",
  "displayName": "KloudHub",
  "description": "KloudHub 계정으로 로그인해 내 환경과 서버를 보고 Remote-SSH 로 바로 접속한다.",
  "version": "0.1.2",
  "publisher": "kloudhub",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/jono03/kloudhub-vscode.git"
  },
  "homepage": "https://github.com/jono03/kloudhub-vscode#readme",
  "bugs": {
    "url": "https://github.com/jono03/kloudhub-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "kloudhub",
    "ssh",
    "remote",
    "kubernetes"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kloudhub",
          "title": "KloudHub",
          "icon": "media/kloudhub.svg"
        }
      ]
    },
    "views": {
      "kloudhub": [
        {
          "id": "kloudhub.servers",
          "name": "내 환경",
          "icon": "media/kloudhub.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kloudhub.servers",
        "contents": "KloudHub 웹 설정에서 발급한 API 토큰으로 로그인하면 내 환경과 서버가 여기에 나온다.\n[로그인](command:kloudhub.login)\nRemote - SSH 확장이 설치되어 있으면 서버를 VS Code 창으로 바로 연다.",
        "when": "!kloudhub.loggedIn"
      }
    ],
    "commands": [
      {
        "command": "kloudhub.login",
        "title": "로그인",
        "category": "KloudHub",
        "icon": "$(sign-in)"
      },
      {
        "command": "kloudhub.logout",
        "title": "로그아웃",
        "category": "KloudHub",
        "icon": "$(sign-out)"
      },
      {
        "command": "kloudhub.refresh",
        "title": "새로고침",
        "category": "KloudHub",
        "icon": "$(refresh)"
      },
      {
        "command": "kloudhub.connect",
        "title": "새 창에서 접속",
        "category": "KloudHub",
        "icon": "$(remote)"
      },
      {
        "command": "kloudhub.connectCurrentWindow",
        "title": "현재 창에서 접속",
        "category": "KloudHub"
      },
      {
        "command": "kloudhub.openTerminal",
        "title": "SSH 터미널 열기",
        "category": "KloudHub",
        "icon": "$(terminal)"
      },
      {
        "command": "kloudhub.copySshCommand",
        "title": "SSH 명령 복사",
        "category": "KloudHub",
        "icon": "$(copy)"
      },
      {
        "command": "kloudhub.setSshUser",
        "title": "SSH 사용자 변경",
        "category": "KloudHub"
      },
      {
        "command": "kloudhub.startServer",
        "title": "시작",
        "category": "KloudHub",
        "icon": "$(debug-start)"
      },
      {
        "command": "kloudhub.stopServer",
        "title": "정지",
        "category": "KloudHub",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kloudhub.startEnv",
        "title": "환경 시작",
        "category": "KloudHub",
        "icon": "$(debug-start)"
      },
      {
        "command": "kloudhub.stopEnv",
        "title": "환경 정지",
        "category": "KloudHub",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kloudhub.downloadKubeconfig",
        "title": "kubeconfig 받기",
        "category": "KloudHub",
        "icon": "$(cloud-download)"
      },
      {
        "command": "kloudhub.openInWeb",
        "title": "웹에서 열기",
        "category": "KloudHub",
        "icon": "$(link-external)"
      },
      {
        "command": "kloudhub.registerSshKey",
        "title": "SSH 공개키 등록",
        "category": "KloudHub",
        "icon": "$(key)"
      },
      {
        "command": "kloudhub.openSshConfig",
        "title": "SSH config 열기",
        "category": "KloudHub",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kloudhub.login",
          "when": "view == kloudhub.servers && !kloudhub.loggedIn",
          "group": "navigation@1"
        },
        {
          "command": "kloudhub.refresh",
          "when": "view == kloudhub.servers && kloudhub.loggedIn",
          "group": "navigation@1"
        },
        {
          "command": "kloudhub.registerSshKey",
          "when": "view == kloudhub.servers && kloudhub.loggedIn",
          "group": "1_keys@1"
        },
        {
          "command": "kloudhub.openSshConfig",
          "when": "view == kloudhub.servers",
          "group": "2_config@1"
        },
        {
          "command": "kloudhub.logout",
          "when": "view == kloudhub.servers && kloudhub.loggedIn",
          "group": "3_auth@1"
        }
      ],
      "view/item/context": [
        {
          "command": "kloudhub.connect",
          "when": "view == kloudhub.servers && viewItem =~ /^server\\.running\\.(direct|jump|private)/",
          "group": "inline@1"
        },
        {
          "command": "kloudhub.openTerminal",
          "when": "view == kloudhub.servers && viewItem =~ /^server\\.running\\.(direct|jump|private)/",
          "group": "inline@2"
        },
        {
          "command": "kloudhub.startServer",
          "when": "view == kloudhub.servers && viewItem =~ /^server\\.stopped\\./",
          "group": "inline@1"
        },
        {
          "command": "kloudhub.connect",
          "when": "view == kloudhub.servers && viewItem =~ /^server\\.(running|stopped)\\.(direct|jump|private)/",
          "group": "1_connect@1"
        },
        {
          "command": "kloudhub.connectCurrentWindow",
          "when": "view == kloudhub.servers && viewItem =~ /^server\\.(running|stopped)\\.(direct|jump|private)/",
          "group": "1_connect@2"
        },
        {
          "command": "kloudhub.openTerminal",
          "when": "view == kloudhub.servers && viewItem =~ /^server\\.(running|stopped)\\.(direct|jump|private)/",
          "group": "1_connect@3"
        },
        {
          "command": "kloudhub.copySshCommand",
          "when": "view == kloudhub.servers && viewItem =~ /^server\\.(running|stopped)\\.(direct|jump|private)/",
          "group": "1_connect@4"
        },
        {
          "command": "kloudhub.setSshUser",
          "when": "view == kloudhub.servers && viewItem =~ /^server\\./",
          "group": "2_settings@1"
        },
        {
          "command": "kloudhub.startServer",
          "when": "view == kloudhub.servers && viewItem =~ /^server\\.stopped\\./",
          "group": "3_power@1"
        },
        {
          "command": "kloudhub.stopServer",
          "when": "view == kloudhub.servers && viewItem =~ /^server\\.running\\..*\\.solo$/",
          "group": "3_power@2"
        },
        {
          "command": "kloudhub.openInWeb",
          "when": "view == kloudhub.servers && viewItem =~ /^(server|env)\\./",
          "group": "9_web@1"
        },
        {
          "command": "kloudhub.startEnv",
          "when": "view == kloudhub.servers && viewItem =~ /^env\\.(stopped|failed)/",
          "group": "inline@1"
        },
        {
          "command": "kloudhub.downloadKubeconfig",
          "when": "view == kloudhub.servers && viewItem =~ /^env\\.(running|stopped)\\.k8s$/",
          "group": "inline@2"
        },
        {
          "command": "kloudhub.startEnv",
          "when": "view == kloudhub.servers && viewItem =~ /^env\\.(stopped|failed)/",
          "group": "3_power@1"
        },
        {
          "command": "kloudhub.stopEnv",
          "when": "view == kloudhub.servers && viewItem =~ /^env\\.(running|failed)/",
          "group": "3_power@2"
        },
        {
          "command": "kloudhub.downloadKubeconfig",
          "when": "view == kloudhub.servers && viewItem =~ /^env\\.(running|stopped)\\.k8s$/",
          "group": "4_k8s@1"
        }
      ],
      "commandPalette": [
        {
          "command": "kloudhub.logout",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.refresh",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.connect",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.connectCurrentWindow",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.openTerminal",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.copySshCommand",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.setSshUser",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.startServer",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.stopServer",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.startEnv",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.stopEnv",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.downloadKubeconfig",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.openInWeb",
          "when": "kloudhub.loggedIn"
        },
        {
          "command": "kloudhub.registerSshKey",
          "when": "kloudhub.loggedIn"
        }
      ]
    },
    "configuration": {
      "title": "KloudHub",
      "properties": {
        "kloudhub.endpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "KloudHub 웹 주소(예: `https://kloudhub.example.ac.kr`). 첫 로그인 때 채워진다."
        },
        "kloudhub.allowSelfSignedCertificate": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "HTTPS 주소의 자체서명 인증서를 허용한다. 중간자 공격을 막지 못하므로 신뢰하는 내부망에서만 켤 것."
        },
        "kloudhub.ssh.defaultUser": {
          "type": "string",
          "default": "",
          "markdownDescription": "서버의 로그인 계정을 알 수 없을 때 쓰는 SSH 사용자명. 비우면 처음 접속할 때 묻는다. (보통은 이미지에서 알아낸다: Ubuntu `ubuntu`, Rocky `rocky` …)"
        },
        "kloudhub.ssh.identityFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "SSH 개인키 경로(예: `~/.ssh/id_ed25519`). 비우면 ssh 기본값과 ssh-agent 를 쓴다."
        },
        "kloudhub.ssh.allowPrivateAddress": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "공인 IP 로 닿지 않는 서버를 사설 IP 로 직접 접속한다. VPN 등으로 KloudHub 내부망에 닿을 때만 켤 것."
        },
        "kloudhub.ssh.configFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "항목을 기록할 SSH config 경로. 비우면 `remote.SSH.configFile`, 그것도 비면 `~/.ssh/config`."
        },
        "kloudhub.ssh.openPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "접속 후 열 원격 폴더(예: `/home/ubuntu/project`). 비우면 폴더 없이 원격 창을 연다."
        },
        "kloudhub.refreshIntervalSeconds": {
          "type": "number",
          "default": 0,
          "markdownDescription": "목록 자동 새로고침 주기(초). 0 이면 끈다. 10 미만은 무시한다.",
          "minimum": 0
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.0.0"
  }
}
